# Copiez ce fichier en .env puis adaptez les valeurs.
PORT=3000
NODE_ENV=development

# OBLIGATOIRE en production : longue chaîne aléatoire (ex : openssl rand -hex 32)
JWT_SECRET=change-moi-par-une-longue-chaine-aleatoire

# Compte administrateur créé au premier démarrage (changez le mot de passe !)
ADMIN_EMAIL=admin@finprep.local
ADMIN_PASSWORD=ChangeMe123!

# Dossier de stockage (base SQLite + PDF). Sur Render/Railway, pointez vers le disque persistant.
DATA_DIR=./data

# Données de démonstration (modules, QCM, compte étudiant demo) au premier démarrage
SEED_DEMO=true

# true = l'inscription est active immédiatement (tests). false = validation manuelle après paiement.
AUTO_ENROLL=false

# Instructions de paiement affichées après une demande d'inscription
PAYMENT_INSTRUCTIONS=Réglez le montant par Orange Money, MTN MoMo ou Wave au +225 00 00 00 00 00 en indiquant votre email en référence. Votre accès est activé sous 24 h après réception.
